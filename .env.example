# Copy this file to .env and replace placeholder values before running.
# NEVER commit .env to GitHub.

# Environment: "development" locally (HTTP) or "production" on DigitalOcean (HTTPS)
APP_ENV=development
PORT=8080

# Generate with: openssl rand -hex 32  (must be >= 32 chars in production)
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Initial super_admin account (bootstrapped once if the users table is empty)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME="Primary Admin"

# Recommended in production: generate hash via `python -m app.cli hash-password`
INITIAL_ADMIN_PASSWORD_HASH=

# Local dev fallback only (ignored if INITIAL_ADMIN_PASSWORD_HASH is set; strong 10+ chars required in production)
INITIAL_ADMIN_PASSWORD=

# Session & Reverse Proxy Security
# Set COOKIE_SECURE=true in production behind HTTPS; false for local HTTP testing
COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8
TRUSTED_PROXY_COUNT=0
TRUST_CLOUDFLARE=false

# Church Display Settings
CHURCH_TIMEZONE=America/Chicago
GUNICORN_WORKERS=2
